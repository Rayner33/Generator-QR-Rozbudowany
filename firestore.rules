rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Weryfikacja: czy użytkownik jest uwierzytelnionym pracownikiem firmy?
    // Sprawdzamy zarówno fakt zalogowania JAK I domenę emaila.
    // Zabezpiecza przed sytuacją, gdy ktoś zaloguje się przez Firebase SDK
    // omijając UI aplikacji, używając konta spoza domeny firmowej.
    function isAppAdmin() {
      return request.auth != null &&
             request.auth.token.email.matches('.*@parys\\.pl$');
    }

    // Reguły dla kolekcji "qrcodes"
    match /qrcodes/{docId} {
      allow list, create, delete: if isAppAdmin();
      
      // Odczyt pojedynczego kodu – publiczny, by RedirectEngine mógł działać
      allow get: if true;
      
      // Update: pracownicy mają pełen dostęp.
      // Publiczny (niezalogowany) użytkownik może TYLKO zinkrementować licznik skanowań.
      allow update: if isAppAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['scans', 'lastClickedAt']) &&
        request.resource.data.scans == resource.data.scans + 1
      );
    }

    // Reguły dla kolekcji "smartlinks" (analogiczne do QR Kodów)
    match /smartlinks/{docId} {
      allow list, create, delete: if isAppAdmin();
      allow get: if true;
      allow update: if isAppAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'lastClickedAt']) &&
        request.resource.data.clicks == resource.data.clicks + 1
      );
    }

    // Reguły dla kolekcji "analytics"
    // Odczyt/aktualizacja/usuwanie tylko dla pracowników.
    // Zapis (create) jest dozwolony publicznie (skanujący nie musi być zalogowany),
    // ale TYLKO jeśli skanowany kod faktycznie istnieje w bazie i dane są poprawne.
    // Zapobiega to zalewaniu bazy fałszywymi danymi przez boty.
    match /analytics/{docId} {
      allow list, read, delete, update: if isAppAdmin();
      allow create: if (
        // Wymagane pola – dokładnie te, które zapisuje tracking.js
        request.resource.data.keys().hasOnly([
          'codeId', 'workspaceId', 'type', 'timestamp',
          'country', 'region', 'city', 'continent',
          'os', 'browser', 'device', 'visitorHash'
        ]) &&
        request.resource.data.codeId is string &&
        request.resource.data.type in ['qr', 'smartlink'] &&
        // Kod musi naprawdę istnieć w bazie – ochrona przed fałszywymi skanami
        (
          exists(/databases/$(database)/documents/qrcodes/$(request.resource.data.codeId)) ||
          exists(/databases/$(database)/documents/smartlinks/$(request.resource.data.codeId))
        )
      );
    }

    // Reguły dla wszystkich pozostałych kolekcji (użytkownicy, workspace, tagi, zaproszenia itp.)
    // Tylko zalogowani pracownicy z domeny firmowej mają dostęp.
    match /{document=**} {
      allow read, write: if isAppAdmin();
    }
  }
}
